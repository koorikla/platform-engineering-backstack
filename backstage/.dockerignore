# The multi-stage Dockerfile builds from source inside the image, so package
# sources and the plugins workspace must stay in the build context. Only
# things that are regenerated in the image, or must never reach it, go here.
.git
node_modules
packages/*/node_modules
plugins/*/node_modules
.yarn/cache
.yarn/install-state.gz

# Build outputs -- rebuilt inside the image; copying host artifacts in would
# risk baking a stale bundle.
packages/*/dist
packages/*/dist-types

# Local configuration: app-config.local.yaml holds a cluster service account
# token generated by `make setup-local-config`.
*.local.yaml

# Test and tooling output
coverage
e2e-test-report
.cache
